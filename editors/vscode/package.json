{
  "name": "epholang-language",
  "displayName": "Epholang",
  "icon": "icon.png",
  "description": "Syntax highlighting, snippets, and basic editing support for Epholang 0.2.0.",
  "version": "0.2.0",
  "publisher": "itsmequote",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "epholang",
    "epho",
    "syntax highlighting",
    "snippets",
    "programming language"
  ],
  "contributes": {
    "languages": [
      {
        "id": "epholang",
        "aliases": [
          "Epholang",
          "epholang"
        ],
        "extensions": [
          ".epho"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "epholang",
        "scopeName": "source.epholang",
        "path": "./syntaxes/epholang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "epholang",
        "path": "./snippets/epholang.json"
      }
    ],
    "configurationDefaults": {
      "[epholang]": {
        "editor.formatOnSave": true,
        "editor.insertSpaces": false,
        "editor.detectIndentation": false
      }
    },
    "configuration": {
      "title": "Epholang",
      "properties": {
        "epholang.executablePath": {
          "type": "string",
          "default": "epholang",
          "description": "Path to the Epholang CLI executable used by EphoFMT."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ItsMeQuote/epholang"
  },
  "scripts": {
    "test": "node tests/validate-extension.mjs"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:epholang"
  ]
}
