{
  "Function": {
    "prefix": "function",
    "description": "Declare a typed Epholang function",
    "body": [
      "function ${1:FunctionName}(${2:value} ${3:int}) ${4:int} {",
      "    return ${4} ${2}",
      "$0}"
    ]
  },
  "If / otherwise": {
    "prefix": "if",
    "description": "Conditional with an alternative",
    "body": [
      "if ${1:condition} {",
      "    $2",
      "} otherwise {",
      "    $0",
      "}"
    ]
  },
  "Import module": {
    "prefix": "import",
    "description": "Import a built-in Epholang module",
    "body": [
      "import \"${1|math,strings,types|}\" as ${2:module}",
      "$0"
    ]
  },
  "Output": {
    "prefix": "Output",
    "description": "Write without automatic line break",
    "body": [
      "Output(${1:\"text\"})$0"
    ]
  },
  "Input": {
    "prefix": "Input",
    "description": "Display a prompt and read a line of text",
    "body": [
      "Input(${1:\"Prompt: \"})$0"
    ]
  },
  "List of integers": {
    "prefix": "list<int>",
    "description": "Typed integer list",
    "body": [
      "list<int>{${1:1, 2, 3}}$0"
    ]
  },
  "List of strings": {
    "prefix": "list<str>",
    "description": "Typed string list",
    "body": [
      "list<str>{${1:\"x\", \"y\", \"z\"}}$0"
    ]
  },
  "Loop with condition": {
    "prefix": "loop",
    "description": "Conditional loop",
    "body": [
      "loop ${1:condition} {",
      "    $0",
      "}"
    ]
  },
  "Loop over list": {
    "prefix": "loop in",
    "description": "Iterate over a list",
    "body": [
      "loop ${1:item} in ${2:items} {",
      "    $0",
      "}"
    ]
  }
}
