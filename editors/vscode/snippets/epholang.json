{
  "Function": {
    "prefix": "function",
    "description": "Declare a typed Epholang function",
    "body": [
      "function ${1:FunctionName}(${2:int} ${3:value}) -> ${4:int}:",
      "\treturn ${4} ${3}",
      "$0"
    ]
  },
  "Import module": {
    "prefix": "import",
    "description": "Import a built-in Epholang module",
    "body": [
      "import \"${1|math,strings,types|}\" as ${2:module}",
      "$0"
    ]
  },
  "Output": {
    "prefix": "Output",
    "description": "Write without automatic line break",
    "body": [
      "Output(${1:\"text\"})$0"
    ]
  },
  "Input": {
    "prefix": "Input",
    "description": "Display a prompt and read a line of text",
    "body": [
      "Input(${1:\"Prompt: \"})$0"
    ]
  },
  "List of integers": {
    "prefix": "list<int>",
    "description": "Typed integer list",
    "body": [
      "list<int>{${1:1, 2, 3}}$0"
    ]
  },
  "List of strings": {
    "prefix": "list<str>",
    "description": "Typed string list",
    "body": [
      "list<str>{${1:\"x\", \"y\", \"z\"}}$0"
    ]
  },
  "Loop with condition": {
    "prefix": "loop",
    "description": "Conditional loop",
    "body": [
      "loop ${1:condition}:",
      "\t$0"
    ]
  },
  "Loop over list": {
    "prefix": "loop in",
    "description": "Iterate over a list",
    "body": [
      "loop ${1:item} in ${2:items}:",
      "\t$0"
    ]
  },
  "If / else": {
    "prefix": "if",
    "description": "Conditional with an alternative",
    "body": [
      "if ${1:condition}:",
      "\t$2",
      "else:",
      "\t$0"
    ]
  },
  "Function without a result": {
    "prefix": "function-no-result",
    "description": "Declare a function that finishes at the end of its body",
    "body": [
      "function ${1:Display}() -|:",
      "\tOutput(${2:\"Hello\"})",
      "$0"
    ]
  },
  "Discard result": {
    "prefix": "discard",
    "description": "Evaluate an expression and discard its value",
    "body": [
      "_ = ${1:expression}"
    ]
  }
}
