{
  "name": "Epholang",
  "scopeName": "source.epholang",
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#tokens"
        }
      ]
    },
    "comments": {
      "name": "comment.block.epholang",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#comments"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.epholang",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "include": "#escapes"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.epholang",
      "match": "\\\\[nt\"\\\\#}]"
    },
    "interpolation": {
      "name": "meta.interpolation.epholang",
      "contentName": "meta.embedded.inline.epholang",
      "begin": "#\\{",
      "end": "\\}|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.epholang"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.epholang"
        }
      },
      "patterns": [
        {
          "include": "#interpolation-code"
        }
      ]
    },
    "interpolation-code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#interpolation-string"
        },
        {
          "include": "#interpolation-braces"
        },
        {
          "include": "#tokens"
        }
      ]
    },
    "interpolation-string": {
      "name": "string.quoted.double.epholang",
      "begin": "\\\\\"",
      "end": "\\\\\"|$",
      "patterns": [
        {
          "include": "#escapes"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "interpolation-braces": {
      "name": "meta.braces.epholang",
      "begin": "\\{",
      "end": "\\}|$",
      "patterns": [
        {
          "include": "#interpolation-code"
        }
      ]
    },
    "tokens": {
      "patterns": [
        {
          "name": "invalid.illegal.operator.epholang",
          "match": "<=|>="
        },
        {
          "name": "meta.function.declaration.epholang",
          "match": "\\b(function)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "storage.type.function.epholang"
            },
            "3": {
              "name": "entity.name.function.definition.epholang"
            }
          }
        },
        {
          "name": "meta.import.alias.epholang",
          "match": "\\b(as)(\\s+)([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.import.epholang"
            },
            "3": {
              "name": "entity.name.namespace.epholang"
            }
          }
        },
        {
          "name": "meta.function-call.module.epholang",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(:)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "variable.other.module.epholang"
            },
            "2": {
              "name": "punctuation.accessor.epholang"
            },
            "3": {
              "name": "entity.name.function.epholang"
            }
          }
        },
        {
          "name": "keyword.control.epholang",
          "match": "\\b(?:if|otherwise|loop|in|return|import)\\b"
        },
        {
          "name": "storage.type.function.epholang",
          "match": "\\bfunction\\b"
        },
        {
          "name": "storage.type.epholang",
          "match": "\\b(?:int|flt|str|bool|none|type|ls|list)\\b"
        },
        {
          "name": "constant.language.epholang",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "support.function.builtin.epholang",
          "match": "\\b(?:Output|Input|Includes|Length|Insert|Remove|TypeOf)(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.call.epholang",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "constant.numeric.float.epholang",
          "match": "(?<![A-Za-z0-9_.])(?:\\d+\\.\\d+|\\.\\d+)(?![A-Za-z0-9_.])"
        },
        {
          "name": "constant.numeric.integer.epholang",
          "match": "(?<![A-Za-z0-9_.])\\d+(?![A-Za-z0-9_.])"
        },
        {
          "name": "keyword.operator.epholang",
          "match": ":=|==|!=|&&|\\|\\||[+*/%^=<>!\\-]"
        },
        {
          "name": "variable.other.readwrite.epholang",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.epholang",
          "match": "[()\\[\\]{},;]"
        }
      ]
    }
  }
}
