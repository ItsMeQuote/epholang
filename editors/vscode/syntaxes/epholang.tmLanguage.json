{
  "name": "Epholang",
  "scopeName": "source.epholang",
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#list-literal"
        },
        {
          "include": "#tokens"
        }
      ]
    },
    "comments": {
      "name": "comment.block.epholang",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#comments"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.epholang",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "include": "#escapes"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.epholang",
      "match": "\\\\[nt\"\\\\#}]"
    },
    "interpolation": {
      "name": "meta.interpolation.epholang",
      "contentName": "meta.embedded.inline.epholang",
      "begin": "#\\{",
      "end": "\\}|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.epholang"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.epholang"
        }
      },
      "patterns": [
        {
          "include": "#interpolation-code"
        }
      ]
    },
    "interpolation-code": {
      "patterns": [
        {
          "include": "#inline-comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#inline-list-literal"
        },
        {
          "include": "#tokens"
        }
      ]
    },
    "tokens": {
      "patterns": [
        {
          "name": "punctuation.separator.return-type.epholang",
          "match": "->|-\\|"
        },
        {
          "name": "keyword.operator.discard.epholang",
          "match": "\\b_\\b(?=[\\t ]*(?:/\\*.*?\\*/[\\t ]*)*=(?!=))"
        },
        {
          "name": "invalid.illegal.discard.epholang",
          "match": "\\b_\\b"
        },
        {
          "name": "punctuation.section.block.epholang",
          "match": ":(?=[\\t ]*(?:/\\*|$))"
        },
        {
          "name": "invalid.illegal.brace.epholang",
          "match": "[{}]"
        },
        {
          "name": "invalid.illegal.operator.epholang",
          "match": "<=|>="
        },
        {
          "name": "meta.function.declaration.epholang",
          "match": "\\b(function)(\\s+)((?!_\\b)[A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "storage.type.function.epholang"
            },
            "3": {
              "name": "entity.name.function.definition.epholang"
            }
          }
        },
        {
          "name": "meta.import.alias.epholang",
          "match": "\\b(as)(\\s+)((?!_\\b)[A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.import.epholang"
            },
            "3": {
              "name": "entity.name.namespace.epholang"
            }
          }
        },
        {
          "name": "meta.function-call.module.epholang",
          "match": "\\b((?!_\\b)[A-Za-z_][A-Za-z0-9_]*)(:)((?!_\\b)[A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "variable.other.module.epholang"
            },
            "2": {
              "name": "punctuation.accessor.epholang"
            },
            "3": {
              "name": "entity.name.function.epholang"
            }
          }
        },
        {
          "name": "keyword.control.epholang",
          "match": "\\b(?:if|else|loop|in|return|import|break|skip)\\b"
        },
        {
          "name": "storage.type.function.epholang",
          "match": "\\bfunction\\b"
        },
        {
          "name": "storage.type.epholang",
          "match": "\\b(?:int|flt|str|bool|none|type|ls|list)\\b"
        },
        {
          "name": "constant.language.epholang",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "support.function.builtin.epholang",
          "match": "\\b(?:Output|Input|Includes|Length|Insert|Remove)(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.call.epholang",
          "match": "\\b(?!_\\b)[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "constant.numeric.float.epholang",
          "match": "(?<![A-Za-z0-9_.])(?:\\d+\\.\\d+|\\.\\d+)(?![A-Za-z0-9_.])"
        },
        {
          "name": "constant.numeric.integer.epholang",
          "match": "(?<![A-Za-z0-9_.])\\d+(?![A-Za-z0-9_.])"
        },
        {
          "name": "keyword.operator.epholang",
          "match": ":=|==|!=|&&|\\|\\||[+*/%^=<>!\\-|]"
        },
        {
          "name": "variable.other.readwrite.epholang",
          "match": "\\b(?!_\\b)[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.epholang",
          "match": "[()\\[\\],;]"
        }
      ]
    },
    "inline-comments": {
      "name": "comment.block.epholang",
      "begin": "/\\*",
      "end": "\\*/|$",
      "patterns": [
        {
          "include": "#inline-comments"
        }
      ]
    },
    "list-literal": {
      "name": "meta.list.literal.epholang",
      "begin": "\\b(list)(?=[\\t ]*<)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.epholang"
        }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "include": "#list-type"
        },
        {
          "include": "#list-body"
        },
        {
          "include": "#comments"
        }
      ]
    },
    "list-type": {
      "name": "meta.list.type.epholang",
      "begin": "<",
      "end": ">",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.type.begin.epholang"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.type.end.epholang"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#tokens"
        }
      ]
    },
    "list-body": {
      "name": "meta.list.elements.epholang",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.list.begin.epholang"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.list.end.epholang"
        }
      },
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "inline-list-literal": {
      "name": "meta.list.literal.epholang",
      "begin": "\\b(list)(?=[\\t ]*<)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.epholang"
        }
      },
      "end": "(?<=\\})|$",
      "patterns": [
        {
          "include": "#inline-list-type"
        },
        {
          "include": "#inline-list-body"
        },
        {
          "include": "#inline-comments"
        }
      ]
    },
    "inline-list-type": {
      "name": "meta.list.type.epholang",
      "begin": "<",
      "end": ">|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.type.begin.epholang"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.type.end.epholang"
        }
      },
      "patterns": [
        {
          "include": "#inline-comments"
        },
        {
          "include": "#tokens"
        }
      ]
    },
    "inline-list-body": {
      "name": "meta.list.elements.epholang",
      "begin": "\\{",
      "end": "\\}|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.list.begin.epholang"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.list.end.epholang"
        }
      },
      "patterns": [
        {
          "include": "#interpolation-code"
        }
      ]
    }
  }
}
