---
import { ru } from "../data/site.ru";
import { code, buildCode, outputs } from "../data/programs";
import Code from "./Code.astro";
import { Download } from "@lucide/astro";
import { url, t, type Lang } from "../data/site";
const { lang } = Astro.props as { lang: Lang };
const tr = (ru: string, en: string) => t(lang, ru, en);
---

<div class="guide-layout">
  <aside class="toc" aria-label={tr(ru.onThisPage, "On this page")}>
    {[
      ["get", tr(ru.step1GetEpholang, "1. Get Epholang")],
      ["write", tr(ru.step2WriteCode, "2. Write code")],
      ["run", tr(ru.step3RunIt, "3. Run it")],
      ["understand", tr(ru.step4Understand, "4. Understand")],
      ["next", tr(ru.step5GoFurther, "5. Go further")],
    ].map(([id, label]) => (
      <a href={"#" + id}>{label}</a>
    ))}
  </aside>
  <article class="content">
    <h2 id="get">{tr(ru.step1GetEpholangText, "1. Get Epholang")}</h2>
    <p>
      {tr(
        ru.theExamplesInThisGuideUseIndentationSyntax,
        "The examples in this guide use Epholang 0.3 Beta. Download a build for your operating system or build the tagged source below.",
      )}
    </p>
    <a class="button" href={url(lang, "download")}>
      <Download size={17} aria-hidden="true" />
      {tr(ru.chooseADownload, "Choose a download")}
    </a>
    <h3>{tr(ru.buildFromSource, "Build from source")}</h3>
    <p>
      {tr(
        ru.youNeedGitCargoAndRust185,
        "You need Git, Cargo and Rust 1.85 or newer. The commands below clone the repository and select the published tag.",
      )}
    </p>
    <Code lang={lang} code={buildCode} name="Terminal" syntax={false} />
    <p>
      {tr(
        ru.theResultIsTargetReleaseEpholangOrTarget,
        "The result is target/release/epholang, or target\\release\\epholang.exe on Windows. The following commands assume its directory is on PATH.",
      )}
    </p>
    <h2 id="write">
      {tr(ru.step2WriteYourFirstProgram, "2. Write your first program")}
    </h2>
    <p>
      {tr(
        ru.createAUtf8TextFileNamedHello,
        "Create a UTF-8 text file named hello.epho. Epholang source files use the .epho extension.",
      )}
    </p>
    <Code
      lang={lang}
      code={code("01_hello.epho")}
      name="hello.epho"
      output={outputs["01_hello.epho"]}
    />
    <h2 id="run">{tr(ru.step3CheckAndRun, "3. Check and run")}</h2>
    <p>
      {tr(
        ru.openATerminalInTheFileSDirectory,
        "Open a terminal in the file’s directory. check validates without executing; run checks first, then executes.",
      )}
    </p>
    <Code
      lang={lang}
      code={"epholang check hello.epho\nepholang run hello.epho"}
      name="PATH"
      syntax={false}
    />
    <p>
      {tr(
        ru.withoutPathUseTheFullOrRelativePath,
        "Without PATH, use the full or relative path to the interpreter.",
      )}
    </p>
    <Code
      lang={lang}
      code={".\\epholang.exe run hello.epho"}
      name="Windows · PowerShell"
      syntax={false}
    />
    <Code
      lang={lang}
      code={"./target/release/epholang run hello.epho"}
      name="Linux / macOS · repository directory"
      syntax={false}
    />
    <h2 id="understand">
      {tr(ru.step4UnderstandTheRules, "4. Understand the rules")}
    </h2>
    <p>
      {tr(
        ru.outputDoesNotAppendANewlineIncludeN,
        "Output does not append a newline: include \\n. Comments use /* ... */ and may be nested. Single-line comments are not supported.",
      )}
    </p>
    <Code
      lang={lang}
      code={code("02_functions.epho")}
      name="02_functions.epho"
      output={outputs["02_functions.epho"]}
    />
    <p>
      {tr(
        ru.squareReturnsAnIntDisplaysquareUsesThatValue,
        "Square returns an int. DisplaySquare uses that value in interpolation. Its -| header lets you call DisplaySquare as a statement. It finishes after Output.",
      )}
    </p>
    <h3>{tr(ru.errorsArePartOfLearning, "Errors are part of learning")}</h3>
    <p>
      {tr(
        ru.unusedVariablesIncompatibleTypesAndMissingReturnsAre,
        "Unused variables, incompatible types and missing returns are static errors and prevent execution. Other errors, such as invalid list indices, depend on values and are detected at runtime.",
      )}
    </p>
    <div class="notice">
      <p>
        {tr(
          ru.intAndFltCannotBeMixedImplicitlyThe,
          "int and flt cannot be mixed implicitly. The first list index is 1. For int / int, the quotient must be exactly representable as flt: 5 / 2 works, while 1 / 3 raises a runtime error.",
        )}
      </p>
    </div>
    <h2 id="next">{tr(ru.step5KeepExploring, "5. Keep exploring")}</h2>
    <p>
      <a href={url(lang, "examples")}>
        {tr(ru.sevenRepositoryExamples, "Seven repository examples")}
      </a>{" "}
      ·{" "}
      <a href={url(lang, "docs")}>
        {tr(ru.guidesAndWiki, "Guides and Wiki")}
      </a>
    </p>
    <p>
      {tr(
        ru.theVsCodeExtensionAddsHighlightingAndSnippets,
        "The VS Code extension adds highlighting and snippets. It is not a language server or compiler.",
      )}
    </p>
  </article>
</div>
