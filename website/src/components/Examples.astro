---
import { code, outputs } from "../data/programs";
import Code from "./Code.astro";
import { ArrowUpRight } from "@lucide/astro";
import { repo, t, examples, type Lang } from "../data/site";
const { lang } = Astro.props as { lang: Lang };
const tr = (ru: string, en: string) => t(lang, ru, en);
---

<article class="content">
  <p>
    {tr(
      "Программы читаются из examples/ существующего репозитория. Код одинаков для обеих локализаций. Здесь нет выполнения в браузере.",
      "Programs are read from the existing repository’s examples/ directory. The code is identical in both locales. There is no in-browser execution.",
    )}
  </p>
  {examples.map((ex) => (
    <section class="example" id={ex.file.slice(0, 2)}>
      <span class="eyebrow">{ex.file}</span>
      <h2>{tr(ex.ru, ex.en)}</h2>
      <p>{tr(ex.r, ex.e)}</p>
      <Code
        lang={lang}
        code={code(ex.file)}
        name={ex.file}
        output={ex.file === "06_math.epho" ? undefined : outputs[ex.file]}
      />
      {ex.file === "06_math.epho" && (
        <p class="small-note">
          {tr(
            "Случайный результат меняется при запуске. Обе границы RandomInterval включены; функция не предназначена для криптографии.",
            "The random result changes between runs. Both RandomInterval bounds are inclusive; the function is not intended for cryptography.",
          )}
        </p>
      )}
      <a class="file" href={repo + "/blob/main/examples/" + ex.file}>
        {tr("Исходный файл на GitHub", "Source file on GitHub")}
        <ArrowUpRight size={13} aria-hidden="true" />
      </a>
    </section>
  ))}
</article>
