---
import { ru } from "../data/site.ru";
import { repo, t, limits, type Lang } from "../data/site";
const { lang } = Astro.props as { lang: Lang };
const tr = (ru: string, en: string) => t(lang, ru, en);
---

<article class="content">
  <h2>{tr(ru.explicitOverShort, "Explicit over short")}</h2>
  <p>
    {tr(
      ru.epholangExploresProgrammingWithExplicitTypesFewOverlapping,
      "Epholang explores programming with explicit types, few overlapping mechanisms and strict rules. The language deliberately omits classes, inheritance and methods.",
    )}
  </p>
  <h2>{tr(ru.currentImplementation, "Current implementation")}</h2>
  <p>
    {tr(
      ru.theRustInterpreterWalksTheSyntaxTreeAfter,
      "The Rust interpreter walks the syntax tree after static checking. The VS Code extension provides highlighting and snippets.",
    )}
  </p>
  <div class="notice">
    <p>{limits[lang]}</p>
  </div>
  <h2>{tr(ru.authorshipAndLicense, "Authorship and license")}</h2>
  <p>
    {tr(
      ru.theLanguageDesignSyntaxSemanticsAndRulesAre,
      "The language design, syntax, semantics and rules are by ItsMeQuote. The implementation was developed with AI assistance. Source code is distributed under the MIT license.",
    )}
  </p>
  <h2>{tr(ru.takePart, "Take part")}</h2>
  <ul class="link-list">
    <li>
      <a href={repo}>{tr(ru.sourceCode, "Source code")}</a>
    </li>
    <li>
      <a href={repo + "/issues"}>
        {tr(
          ru.reportABugOrSuggestAnImprovement,
          "Report a bug or suggest an improvement",
        )}
      </a>
    </li>
    <li>
      <a href={repo + "/blob/main/CONTRIBUTING.md"}>
        {tr(ru.contributingGuidelines, "Contributing guidelines")}
      </a>
    </li>
    <li>
      <a
        href={
          repo +
          "/blob/main/" +
          (lang === "ru" ? "ROADMAP.ru.md" : "ROADMAP.md")
        }
      >
        {tr(ru.possibleFutureDirections, "Possible future directions")}
      </a>
      <p>
        {tr(
          ru.noPromisedDatesPrioritiesMayChange,
          "No promised dates: priorities may change.",
        )}
      </p>
    </li>
    <li>
      <a href="https://t.me/epholang">
        {tr(ru.telegramCommunity, "Telegram community")}
      </a>
      <p>{tr(ru.discussionsInRussian, "Discussions in Russian.")}</p>
    </li>
  </ul>
</article>
