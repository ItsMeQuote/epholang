---
import { ru } from "../data/site.ru";
import { buildCode } from "../data/programs";
import Code from "./Code.astro";
import { Download } from "@lucide/astro";
import { repo, url, t, type Lang } from "../data/site";
import release from "../data/release.json";
const { lang } = Astro.props as { lang: Lang };
const tr = (ru: string, en: string) => t(lang, ru, en);
---

<article class="content">
  <div class="notice">
    <p>
      {tr(ru.currentPublishedRelease, "Current published release")}:{" "}
      <strong>{release.name}</strong> ·{" "}
      <time datetime={release.publishedAt}>
        {new Intl.DateTimeFormat(lang === "ru" ? "ru-RU" : "en-GB", {
          dateStyle: "long",
          timeZone: "UTC",
        }).format(new Date(release.publishedAt))}
      </time>
      . {tr(ru.prerelease, "Prerelease.")}
    </p>
  </div>
  <div class="download-grid">
    {release.assets.map((asset) => (
      <section class="download-card">
        <span class="eyebrow">{asset.platform}</span>
        <h2>
          {asset.kind === "interpreter"
            ? tr(ru.interpreter, "Interpreter")
            : tr(ru.editorExtension, "Editor extension")}
        </h2>
        <p>
          {asset.kind === "interpreter"
            ? tr(
                ru.platformBinary,
                "Download the interpreter for the platform shown above.",
              )
            : tr(
                ru.highlightingAndSnippetsForVsCode190,
                "Highlighting and snippets for VS Code 1.90+.",
              )}
        </p>
        <a class="button" href={asset.url}>
          <Download size={16} aria-hidden="true" />
          {asset.name}
        </a>
      </section>
    ))}
  </div>
  <p style="margin-top:24px">
    <a href={release.url}>{tr(ru.thisRelease, "This release")}</a> ·{" "}
    <a href={repo + "/releases"}>{tr(ru.allReleases, "All releases")}</a>
  </p>
  <h2>
    {tr(
      ru.linuxAndMacosBuildFromSource,
      "Linux and macOS: build from source",
    )}
  </h2>
  <p>
    {tr(
      ru.thePublishedReleaseHasNoPrebuiltLinuxOr,
      "To build from source, install Git, Cargo and Rust 1.85 or later. Use the release tag to check out the matching source.",
    )}
  </p>
  <Code lang={lang} code={buildCode} syntax={false} name="Terminal" />
  <p>
    {tr(
      ru.executableTargetReleaseEpholangWindowsTargetReleaseEpholang,
      "Executable: target/release/epholang (Windows: target\\release\\epholang.exe). The build targets your current platform.",
    )}
  </p>
  <h2>{tr(ru.installTheVsCodeExtension, "Install the VS Code extension")}</h2>
  <p>
    {tr(
      ru.inExtensionsOpenTheMenuAndChooseInstall,
      "In Extensions, open the menu and choose Install from VSIX… or run this command in the downloaded file’s directory.",
    )}
  </p>
  <Code
    lang={lang}
    code={
      "code --install-extension " +
      release.assets.find((a) => a.kind === "editor")!.name
    }
    syntax={false}
    name="Terminal"
  />
  <p>
    <a
      href={
        repo +
        "/blob/main/" +
        (lang === "ru" ? "CHANGELOG.ru.md" : "CHANGELOG.md")
      }
    >
      {tr(ru.changelog, "Changelog")}
    </a>{" "}
    ·{" "}
    <a href={url(lang, "getting-started")}>
      {tr(ru.runYourFirstProgram, "Run your first program")}
    </a>
  </p>
  <p class="small-note">
    {tr(ru.linksReviewed, "Links reviewed")}: {release.checkedAt}.{" "}
    {tr(
      ru.noSystemRequirementsBeyondThoseDocumentedByThe,
      "No system requirements beyond those documented by the project are claimed.",
    )}
  </p>
</article>
