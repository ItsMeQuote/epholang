---
import { ru } from "../data/site.ru";
import { code } from "../data/programs";
import Code from "./Code.astro";
import { ArrowUpRight } from "@lucide/astro";
import { repo, t, type Lang } from "../data/site";
const { lang } = Astro.props as { lang: Lang };
const tr = (ru: string, en: string) => t(lang, ru, en);
const wiki = [
  ["Introduction", ru.introduction, "Introduction"],
  ["Installation", ru.installation, "Installation"],
  ["Hello-World", ru.helloWorld, "Hello World"],
  ["Syntax-Overview", ru.syntaxOverview, "Syntax overview"],
  ["Variables-and-Types", ru.variablesAndTypes, "Variables and types"],
  ["Functions", ru.functionsReference, "Functions and result handling"],
  ["Standard-Library", ru.standardLibraryReference, "Built-in functions and standard modules"],
  ["CLI-Reference", ru.cliReference, "CLI, EphoFMT and VS Code"],
  ["Migration-to-0.3", ru.migrationReference, "Migrate from Epholang 0.2"],
  ["Project-Structure", ru.projectStructure, "Project structure"],
];
---

<article class="content">
  <div class="notice">
    <p>
      {tr(
        ru.detailedDocumentationLivesInTheEnglishGithubWiki,
        "The English GitHub Wiki covers Epholang 0.3 Beta, from installation and a first program to the language and module reference.",
      )}
    </p>
  </div>
  <h2>{tr(ru.guidesAndReference, "Guides and reference")}</h2>
  <ul class="link-list">
    {wiki.map(([s, ru, en]) => (
      <li>
        <a href={repo + "/wiki/" + s}>
          {tr(ru, en)}
          <ArrowUpRight size={15} aria-hidden="true" />
        </a>
        <p>GitHub Wiki · English</p>
      </li>
    ))}
  </ul>
  <h2>{tr(ru.syntaxEssentials, "Syntax essentials")}</h2>
  <p>
    {tr(
      ru.putTheTypeBeforeTheVariableNameUse,
      "Put the type before the variable name. Use := to declare it and = to assign a value. Indent the body one tab after a block header ending in a colon. Import strings, math and types at the start of the file.",
    )}
  </p>
  <Code lang={lang} code={code("07_types.epho")} name="07_types.epho" />
  <h2>{tr(ru.functionResults, "Function results")}</h2>
  <p>
    {tr(
      ru.aFunctionDeclaredWithNoneReturnsTheValue,
      "A function declared with -> none returns the value null. A function declared with -| finishes at the end of its body and forbids return. Call it as a statement, like Output.",
    )}
  </p>
  <p>
    {tr(
      ru.useEachExpressionThatProducesAValueOr,
      "Use each expression that produces a value, or explicitly discard it with _ = expression. The right side runs once. A lone _ is valid only on the left of this statement. Writing x = _ is an error and cannot delete a declaration.",
    )}
  </p>
  <h2>{tr(ru.commandLineTools, "Command-line tools")}</h2>
  <Code
    lang={lang}
    code={
      "epholang run program.epho\nepholang check program.epho\nepholang tokens program.epho\nepholang parse program.epho\nepholang format program.epho\nepholang format --check program.epho"
    }
    name="CLI"
    syntax={false}
  />
  <p>
    {tr(
      ru.runChecksAndExecutesAProgramCheckRuns,
      "run checks and executes a program. check runs static checks. tokens and parse show the tokens and syntax tree. format formats the file, and format --check verifies formatting.",
    )}
  </p>
  <p>
    <a href={repo + "/blob/main/src/main.rs"}>
      {tr(
        ru.inspectTheInterpreterSource,
        "Inspect the interpreter source",
      )}
    </a>
  </p>
</article>
