---
import { ru } from "../data/site.ru";
import { code, outputs } from "../data/programs";
import Code from "./Code.astro";
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import { base, repo, url, t, features, limits, type Lang } from "../data/site";
import release from "../data/release.json";
const { lang } = Astro.props as { lang: Lang };
const tr = (ru: string, en: string) => t(lang, ru, en);
---

<section class="hero">
  <div>
    <div class="hero-logo">
      <img
        src={base + "assets/epholang_logo_icon.png"}
        alt={tr(ru.epholangLogo, "Epholang logo")}
        width="40"
        height="48"
      />
      <span class="version">{release.name}</span>
    </div>
    <span class="eyebrow">
      {tr(
        ru.anExperimentalProgrammingLanguage,
        "An experimental programming language",
      )}
    </span>
    <h1>
      {tr(ru.explicitTypes, "Explicit types.")}
      <br />
      {tr(ru.readableCode, "Readable code.")}
      <br />
      {tr(ru.strictChecking, "Strict checking.")}
    </h1>
    <p class="lead">
      {tr(
        ru.epholangMakesItsRulesVisibleFromAVariable,
        "Epholang makes its rules visible, from a variable declaration to a return value. Implemented in Rust, it checks your program before execution.",
      )}
    </p>
    <div class="actions">
      <a class="button" href={url(lang, "getting-started")}>
        {tr(ru.getStarted, "Get started")}
        <ArrowRight size={17} aria-hidden="true" />
      </a>
      <a class="button secondary" href={url(lang, "docs")}>
        {tr(ru.documentation, "Documentation")}
      </a>
    </div>
    <p class="small-note">
      {tr(
        ru.alphaTheLanguageIsEvolvingAndItsRules,
        "Alpha: the language is evolving and its rules may change.",
      )}
    </p>
  </div>
  <div>
    <div data-tabs>
      <div class="tab-list" aria-label={tr(ru.codeExamples, "Code examples")}>
        <button hidden id="tab-square" data-tab>
          {tr(ru.squares, "Squares")}
        </button>
        <button hidden id="tab-hello" data-tab>
          Hello
        </button>
        <button hidden id="tab-types" data-tab>
          {tr(ru.types, "Types")}
        </button>
      </div>
      <div id="panel-square" data-panel>
        <Code
          code={code("02_functions.epho")}
          name="02_functions.epho"
          lang={lang}
          output={outputs["02_functions.epho"]}
        />
      </div>
      <div id="panel-hello" data-panel>
        <Code
          code={code("01_hello.epho")}
          name="01_hello.epho"
          lang={lang}
          output={outputs["01_hello.epho"]}
        />
      </div>
      <div id="panel-types" data-panel>
        <Code
          code={code("07_types.epho")}
          name="07_types.epho"
          lang={lang}
          output={outputs["07_types.epho"]}
        />
      </div>
    </div>
    <p class="small-note">
      {tr(
        ru.realEpholangSyntaxADemonstrationWithoutInBrowser,
        "Real Epholang syntax. A demonstration without in-browser execution.",
      )}
    </p>
  </div>
</section>
<section class="section">
  <div class="section-heading">
    <div>
      <span class="eyebrow">
        {tr(ru.deliberateRules, "Deliberate rules")}
      </span>
      <h2>
        {tr(
          ru.lessImplicitMoreExplicit,
          "Less implicit. More explicit.",
        )}
      </h2>
    </div>
  </div>
  <div class="feature-grid">
    {features.map((f, i) => (
      <article class="feature">
        <span class="number">0{i + 1}</span>
        <h3>{lang === "ru" ? f[0] : f[1]}</h3>
        <p>{lang === "ru" ? f[2] : f[3]}</p>
        <code>{f[4]}</code>
      </article>
    ))}
  </div>
</section>
<section class="section mascot-section">
  <div>
    <span class="eyebrow">
      {tr(ru.fromALineToAProgram, "From a line to a program")}
    </span>
    <h2>{tr(ru.startWithSomethingSmall, "Start with something small.")}</h2>
    <p class="lead">
      {tr(
        ru.getTheInterpreterCreateYourFirstEphoFile,
        "Get the interpreter, create your first .epho file and explore it step by step. Hexer is ready to join you.",
      )}
    </p>
    <a class="button secondary" href={url(lang, "getting-started")}>
      {tr(ru.helloWorld, "Your first program")}
      <ArrowRight size={17} aria-hidden="true" />
    </a>
  </div>
  <img
    src={base + "assets/epholang_hexer_laptop.png"}
    alt={tr(ru.hexerHoldingALaptop, "Hexer holding a laptop")}
    width="332"
    height="252"
    loading="lazy"
  />
</section>
<section class="section">
  <span class="eyebrow">{tr(ru.projectStatus, "Project status")}</span>
  <h2>
    {tr(
      ru.anExperimentOpenToExploration,
      "An experiment, open to exploration.",
    )}
  </h2>
  <div class="notice">
    <p>{limits[lang]}</p>
  </div>
  <div class="actions">
    <a class="button" href={url(lang, "examples")}>
      {tr(ru.exploreExamples, "Explore examples")}
      <ArrowRight size={17} aria-hidden="true" />
    </a>
    <a href={repo}>
      GitHub
      <ArrowUpRight size={15} aria-hidden="true" />
    </a>
  </div>
</section>
